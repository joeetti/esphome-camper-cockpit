# Vorlage: als secrets.yaml in deinen ESPHome-Ordner kopieren und ausfüllen.
# Die echte secrets.yaml niemals auf GitHub hochladen!

wifi_ssid: "MeinWLAN"
wifi_password: "MeinWLANPasswort"

# Erzeugen z. B. mit: openssl rand -base64 32
# (oder den Schlüssel nehmen, den der ESPHome-Assistent beim Anlegen vorschlägt)
cockpit_api_encryption_key: "BASE64-SCHLUESSEL-MIT-32-BYTES="

# Passwort für das Notfall-WLAN des Displays (mind. 8 Zeichen)
cockpit_fallback_password: "MindestensAchtZeichen"

# Home Assistant > Profil > Sicherheit > Langlebige Zugriffstoken
# WICHTIG: mit "Bearer " (inkl. Leerzeichen) davor. So bleibt der Token
# in ESPHome-Ausgaben als Secret erkannt und wird nicht im Klartext gezeigt.
cockpit_ha_bearer_token: "Bearer eyJhbGciOi..."
